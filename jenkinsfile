pipeline {
    agent any
 
    environment {
        DEPLOY_DIR = 'C:/jenkins/deploy/springboot'
        JAR_NAME   = 'app.jar'
        APP_PORT  = '9090'
        APP_URL   = 'http://127.0.0.1:9090/'
    }
 
    tools {
        maven 'Maven3.9'
        jdk 'JDK17'
    }
 
    stages {
 
        stage('Checkout') {
            steps {
                git credentialsId: 'github-ssh',
                    url: 'git@github.com:swetha-200160/springboot.git'
            }
        }
 
        stage('Build') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }
 
        stage('Deploy & Run (Local)') {
    steps {
        bat '''
        echo ==== Stop app if running ====
        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :%APP_PORT%') do taskkill /PID %%a /F
 
        echo ==== Create deploy directory ====
        if not exist "%DEPLOY_DIR%" mkdir "%DEPLOY_DIR%"
 
        echo ==== Copy JAR ====
        copy /Y target\\demo-0.0.1-SNAPSHOT.jar "%DEPLOY_DIR%\\%JAR_NAME%"
 
        echo ==== Start application in background ====
        cd /d "%DEPLOY_DIR%"
 
        start "" cmd /c "java -jar %JAR_NAME% --server.port=%APP_PORT% > app.log 2>&1"
        '''
    }
}
 
        stage('Verify Application') {
            steps {
                bat '''
                echo ==== Waiting for application startup ====
                ping 127.0.0.1 -n 20 > nul
 
                echo ==== Checking HTTP endpoint ====
                powershell -Command "try { $r = Invoke-WebRequest -Uri '%APP_URL%' -UseBasicParsing -TimeoutSec 10; if ($r.StatusCode -ne 200) { exit 1 } } catch { exit 1 }"
                '''
            }
        }
    }
 
    post {
        success {
            echo "✅ Application is running at ${APP_URL}"
        }
        failure {
            echo "❌ Deployment failed. Check app.log"
        }
    }
}